  "components": {
    "schemas": {
      "AccessRequestIn": {
        "properties": {
          "operator_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Operator Name"
          },
          "operator_title": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Operator Title"
          },
          "scope": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Scope"
          },
          "excludes": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Excludes"
          },
          "reason": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Reason"
          },
          "incident_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Ref"
          }
        },
        "type": "object",
        "required": [
          "operator_name",
          "operator_title",
          "scope",
          "excludes",
          "reason"
        ],
        "title": "AccessRequestIn"
      },
      "ContactIn": {
        "properties": {
          "role": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Role"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "role",
          "name",
          "email"
        ],
        "title": "ContactIn"
      },
      "EnrolInstitutionRequest": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^\\d{4}$",
            "title": "Code",
            "description": "BoG institution code, 4 digits"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "universal_bank",
              "rural_bank",
              "savings_and_loans",
              "microfinance",
              "other"
            ],
            "title": "Type"
          },
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/ContactIn"
            },
            "type": "array",
            "title": "Contacts"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "type"
        ],
        "title": "EnrolInstitutionRequest"
      },
      "EnrolledClient": {
        "properties": {
          "client_id": {
            "type": "string",
            "title": "Client Id"
          },
          "environment": {
            "type": "string",
            "enum": [
              "sandbox",
              "production"
            ],
            "title": "Environment"
          },
          "certificate_not_after": {
            "type": "string",
            "title": "Certificate Not After"
          },
          "revoked": {
            "type": "boolean",
            "title": "Revoked"
          }
        },
        "type": "object",
        "required": [
          "client_id",
          "environment",
          "certificate_not_after",
          "revoked"
        ],
        "title": "EnrolledClient"
      },
      "EnrolledInstitution": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "type": {
            "type": "string",
            "enum": [
              "universal_bank",
              "rural_bank",
              "savings_and_loans",
              "microfinance",
              "other"
            ],
            "title": "Type"
          },
          "status": {
            "type": "string",
            "enum": [
              "enrolled",
              "live",
              "suspended"
            ],
            "title": "Status"
          },
          "enrolled_at": {
            "type": "string",
            "title": "Enrolled At"
          },
          "clients": {
            "items": {
              "$ref": "#/components/schemas/EnrolledClient"
            },
            "type": "array",
            "title": "Clients"
          },
          "signing_keys": {
            "items": {
              "$ref": "#/components/schemas/EnrolledKey"
            },
            "type": "array",
            "title": "Signing Keys"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "type",
          "status",
          "enrolled_at",
          "clients",
          "signing_keys"
        ],
        "title": "EnrolledInstitution"
      },
      "EnrolledInstitutionList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/EnrolledInstitution"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "EnrolledInstitutionList"
      },
      "EnrolledKey": {
        "properties": {
          "kid": {
            "type": "string",
            "title": "Kid"
          },
