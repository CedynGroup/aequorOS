# Supervisor portal configuration. Server-side only: nothing here is exposed
# to the browser. Copy to .env.local for local development.

# local | test | sandbox | production. Unset means "local" under `next dev`
# and "production" otherwise (the strict behaviour).
GATEWAY_ENV=local

# 1 = serve the design's synthetic fixtures without the gateway API, and sign
# in as one of SPEC Part 4's synthetic staff without an identity provider.
# Refused when GATEWAY_ENV=production.
GATEWAY_PORTAL_MOCK=1

# The gateway service (real mode). Default in local/test: http://localhost:8200
GATEWAY_API_URL=http://localhost:8200

# BoG's OIDC identity provider. Defaults in local/test: the API's development
# provider and the portal's client id.
GATEWAY_OIDC_ISSUER=http://localhost:8200/dev/oidc
GATEWAY_OIDC_CLIENT_ID=srg-portal
# Only if the provider registers the portal as a confidential client.
GATEWAY_OIDC_CLIENT_SECRET=
# Default: "openid profile email". Add "groups" if the provider needs it to
# release the groups claim.
GATEWAY_OIDC_SCOPE=openid profile email

# Encrypts the session cookie (AES-256-GCM). At least 32 characters; required
# outside local/test. Generate with: openssl rand -base64 48
GATEWAY_PORTAL_SESSION_SECRET=

# The portal's public origin when it sits behind a proxy (used to build the
# OIDC redirect URI, which must be registered with the provider as
# <origin>/auth/callback).
GATEWAY_PORTAL_BASE_URL=
