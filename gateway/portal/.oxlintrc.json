{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "unicorn",
    "oxc",
    "jsx-a11y",
    "nextjs"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    ".next/**",
    ".test-out/**",
    "next-env.d.ts"
  ],
  "rules": {
    "react/purity": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/control-has-associated-label": [
      "error",
      {
        "ignoreElements": [
          "audio",
          "canvas",
          "embed",
          "input",
          "textarea",
          "tr",
          "video",
          "td",
          "th"
        ]
      }
    ]
  }
}
