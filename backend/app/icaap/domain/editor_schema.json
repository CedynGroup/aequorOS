  "parity_notes": {
    "groups": "ProseMirror writes several groups as one space-separated string; compare spec.group.split(' ') with this list, ignoring order.",
    "doc_content": "block* (not Tiptap's default block+): the server must be able to store a section nobody has written yet. The editor overrides Document with content: 'block*'.",
