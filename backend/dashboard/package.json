{
  "name": "@aequoros/dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev -p 3001",
    "build": "next build && node scripts/assert-home-route-bundle.mjs",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "pnpm test:legacy && vitest run && rm -rf .test-out",
    "e2e": "uv run --project .. python ../scripts/local_services.py run --storage -- node node_modules/@playwright/test/cli.js test",
    "e2e:visual": "uv run --project .. python ../scripts/local_services.py run --storage -- node node_modules/@playwright/test/cli.js test --config playwright.visual.config.ts",
    "test:legacy": "rm -rf .test-out && tsc -p tsconfig.test.json && node --test scripts/*.test.mjs && node scripts/run-unit-tests.mjs",
    "test:coverage": "node scripts/run-unit-coverage.mjs",
    "coverage:ratchet": "node scripts/run-unit-coverage.mjs --update"
  },
  "dependencies": {
    "@aequoros/risk-service-api": "workspace:*",
    "@tanstack/react-query": "^5",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.49.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grid-layout": "2.3.0"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "1.62.0",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "c8": "^12.0.0",
    "eslint": "10.12.0",
    "eslint-config-next": "16.3.6",
    "fast-check": "^4.10.2",
    "istanbul-lib-coverage": "^3.2.2",
    "jose": "^6.2.12",
    "postcss": "^8.5.28",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.3"
  },
  "license": "SEE LICENSE IN LICENSE"
}
