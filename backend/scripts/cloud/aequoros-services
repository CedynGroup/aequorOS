#!/bin/bash
# Runs backend/scripts/local_services.py as the test user (initdb refuses root).
# Usage: aequoros-services --postgres [--storage] [--role-admin] -- <command using .venv/bin/python>
# Set AEQUOROS_ROOT to target another worktree.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/lib.sh"
install -d -o aqs -g aqs "$ROOT/.local-services"
as_aqs bash -c 'cd "$0/backend" && exec .venv/bin/python scripts/local_services.py run "$@"' "$ROOT" "$@"
