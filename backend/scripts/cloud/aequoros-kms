#!/bin/bash
# Usage: aequoros-kms start|stop. Local KMS emulator (synthetic keys only) on 127.0.0.1:18080.
# Same image digest as backend/docker-compose.yml. Starts the Docker daemon when it is not running.
# Keys live in the aequoros-kms-data volume, which survives stop; `docker volume rm aequoros-kms-data` resets them.
set -euo pipefail
IMG=nsmithuk/local-kms:3.11.7@sha256:360d7377b6f3687c89a622236791e4fa3f7316366267b437829edbdfa8a5fc60
case "${1:-}" in
  start)
    command -v docker >/dev/null && command -v dockerd >/dev/null || { echo "aequoros-kms needs Docker; run backend/scripts/cloud/setup.sh" >&2; exit 1; }
    if ! docker info >/dev/null 2>&1; then
      nohup dockerd >/var/log/dockerd.log 2>&1 </dev/null &
      for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 1; done
    fi
    docker start risk-kms >/dev/null 2>&1 || docker run -d --name risk-kms -e KMS_REGION=us-east-1 \
      -e KMS_ACCOUNT_ID=111122223333 -v aequoros-kms-data:/data -p 127.0.0.1:18080:8080 "$IMG" >/dev/null
    for _ in $(seq 1 30); do curl -s -o /dev/null http://127.0.0.1:18080 && exit 0; sleep 1; done
    echo "KMS emulator did not become reachable" >&2; exit 1 ;;
  stop) docker rm -f risk-kms >/dev/null 2>&1 || true ;;
  *) echo "usage: aequoros-kms start|stop" >&2; exit 2 ;;
esac
