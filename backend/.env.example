APP_ENV=local
APP_NAME=risk-service
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO

# Primary database: the shared remote Postgres (managed, TimescaleDB-enabled).
# Real credentials live only in the untracked .env — never commit them.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<postgres-host>:<port>/<database>
#
# Postgres-gated tests (migrations/RLS) opt in explicitly and run in a
# disposable per-run schema (risk_service_test_<hex>, dropped on teardown),
# so pointing them at the shared remote database is safe:
# TEST_DATABASE_URL=postgresql+psycopg://<user>:<password>@<postgres-host>:<port>/<database>
#
# Local fallback (docker compose up -d): postgresql+psycopg://postgres:postgres@localhost:15432/risk_service

# Object storage — one MinIO credential set serves the whole service (Data
# Engine canonical tiers + document uploads + presigned URLs + storage health).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aequoros
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
STORAGE_BACKEND=minio
STORAGE_ENV=mvp
# Mandatory for STORAGE_ENV=mvp: the date this self-hosted MinIO must be retired.
STORAGE_RETIRE_AFTER=2027-01-14
STORAGE_PRESIGN_EXPIRES_SECONDS=900
RISK_MAX_UPLOAD_BYTES=25000000

# --- Authentication --------------------------------------------------------
# Signs + verifies app JWTs (HS256). MUST be set to a strong random value in any
# real environment (generate with `openssl rand -base64 48`); when unset the auth
# layer fails closed rather than falling back to the old header-trust.
AUTH_JWT_SECRET=change-me-openssl-rand-base64-48
# SSO (own OIDC relying party): per-org connections live in the sso_connections
# table (dashboard Settings -> Authentication); the backend verifies id_tokens
# against the connection issuer's JWKS before minting app tokens. This key gates
# the dashboard server's internal fetch of the OIDC client config; must match the
# dashboard's SSO_INTERNAL_KEY. Generate: openssl rand -hex 32
SSO_INTERNAL_KEY=

# Synthetic demo-bank seeding (POST /banks/seed-demo). DEFAULT OFF — all bank data
# flows through the Data Engine; this exists only for isolated test environments.
# NEVER enable against the primary database.
DEMO_SEED_ENABLED=

# Attestation / e-signature requirement (docs/attestation_esignature.md §9 D16).
# Default 1: every return must be preparer+approver signed before submission
# (per the resolved signing policy). Set 0 as a deployment-wide kill-switch:
# no return demands a signature — even configured mandatory policies go dormant
# (resumed unchanged on re-enable) — and returns are submitted after the bare
# maker-checker approval. Accepts yes/no/true/false/1/0. Orthogonal to
# ATTESTATION_SIGNING_ENABLED, which gates whether this deployment CAN sign.
# ATTESTATION_ESIGN_REQUIRED=1

# --- Operator control plane (docs/internal/developer.md) --------------------
# The operator API is a SEPARATE app (uv run uvicorn app.operator.main:app
# --port ${OPERATOR_PORT:-8100}) for AequorOS staff: tenant provisioning and
# cross-tenant ops visibility. Deploy behind allowlist/VPN, never on the
# tenant host.
#
# OPERATOR_PORT — port the operator uvicorn binds (default 8100).
# OPERATOR_PORT=8100
#
# OPERATOR_CORS_ORIGINS — comma-separated origins for the staff console UI
# (empty = no CORS, same-origin/curl only).
# OPERATOR_CORS_ORIGINS=
#
# OPERATOR_DATABASE_URL — the operator's OWN database role. Cross-tenant reads
# on the RLS-forced primary require BYPASSRLS (the worker-role precedent);
# unset falls back to WORKER_DATABASE_URL, then DATABASE_URL (fine for local
# SQLite/hermetic runs; a tenant-scoped role would just see zero rows).
# OPERATOR_DATABASE_URL=
#
# OPERATOR_DEV_AUTH_ENABLED — development bearer-token auth (default 0/off).
# FORBIDDEN in production: with APP_ENV=production the operator app refuses
# to boot. Local dev only.
# OPERATOR_DEV_AUTH_ENABLED=0
#
# OPERATOR_DEV_TOKEN — the static dev bearer value (generate: openssl rand
# -hex 32). Only honored when dev auth is enabled outside production.
# OPERATOR_DEV_TOKEN=
#
# OPERATOR_DEV_EMAIL — the identity recorded in operator_audit_log for
# dev-token requests (default dev@aequoros.com).
# OPERATOR_DEV_EMAIL=dev@aequoros.com
#
# OPERATOR_OIDC_ISSUER / OPERATOR_OIDC_CLIENT_ID — workforce OIDC (Google
# Workspace / Okta). Bearer id_tokens are verified against the issuer's JWKS
# (same zero-trust machinery as customer SSO); unset means no OIDC sign-in.
# OPERATOR_OIDC_ISSUER=
# OPERATOR_OIDC_CLIENT_ID=
#
# OPERATOR_OIDC_ALLOWED_DOMAIN — the workforce email domain (default
# aequoros.com). Tokens must carry a VERIFIED email under this domain.
# OPERATOR_OIDC_ALLOWED_DOMAIN=aequoros.com
#
# OPERATOR_AWS_KMS_ENABLED — per-tenant KMS key + SSE-KMS default encryption
# during provisioning (developer.md §2a; default 0/off). Off = the saga
# records the kms step as skipped and the tenant provisions on MinIO without
# per-tenant keys — honestly reported, never faked.
# OPERATOR_AWS_KMS_ENABLED=0
