# ---------------------------------------------------------------------------
# Operator console environment. ALL of these are SERVER-side (route handlers);
# nothing here is exposed to the browser — there are no NEXT_PUBLIC_* vars.
# The browser talks only to this console's own /api/* routes.
# ---------------------------------------------------------------------------

# Operator API origin — the staff-facing FastAPI app at backend/app/operator
# (its OWN ASGI entrypoint: uv run uvicorn app.operator.main:app --port 8100).
# The console's /api/op proxy forwards every operator call here, so the API
# only needs to be reachable from the console server, not from browsers.
OPERATOR_API_URL=http://127.0.0.1:8100

# --- Workforce SSO (full OIDC authorization-code + PKCE) --------------------
# The SAME issuer + client id the backend verifies with (backend/.env:
# OPERATOR_OIDC_ISSUER / OPERATOR_OIDC_CLIENT_ID / OPERATOR_OIDC_ALLOWED_DOMAIN).
# Leave unset to hide the SSO button (dev-token sign-in only).
#
# Google Workspace setup (console.cloud.google.com → APIs & Services →
# Credentials → OAuth client ID, type "Web application"):
#   - Authorized redirect URI: <console origin>/api/auth/callback
#     (e.g. https://console.aequoros.com/api/auth/callback — and
#      http://localhost:3002/api/auth/callback for local testing)
#   - OPERATOR_OIDC_ISSUER=https://accounts.google.com
#   - client id/secret from the created OAuth client
# The id_token never reaches browser JS: it lives in an HttpOnly cookie and
# the /api/op proxy attaches it server-side. The operator API independently
# verifies signature/issuer/audience/email domain on every request, then
# requires a matching active operator_users row and uses that row's explicit
# role. An allowed-domain identity is not automatically an operator.
OPERATOR_OIDC_ISSUER=
OPERATOR_OIDC_CLIENT_ID=
OPERATOR_OIDC_CLIENT_SECRET=

# Overrides the redirect_uri origin when the console runs behind a reverse
# proxy that rewrites Host. Usually unnecessary.
# CONSOLE_BASE_URL=https://console.aequoros.com

# --- Local dev-token sign-in -------------------------------------------------
# Needs the backend side only (no console vars):
#   OPERATOR_DEV_AUTH_ENABLED=1
#   OPERATOR_DEV_TOKEN=<the token you paste on /login>
# Dev auth is hard-refused by the backend when APP_ENV=production.
