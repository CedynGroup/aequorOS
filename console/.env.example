# Operator API origin — the staff-facing FastAPI app at backend/app/operator
# (its OWN ASGI entrypoint: uv run uvicorn app.operator.main:app --port 8100).
# All authenticated endpoints live under /operator/v1 (bearer token);
# the unauthenticated health probe is GET /operator/health.
#
# The backend must allow this console's origin:
#   OPERATOR_CORS_ORIGINS=http://localhost:3002
# and, for local dev-token sign-in:
#   OPERATOR_DEV_AUTH_ENABLED=1
#   OPERATOR_DEV_TOKEN=<the token you paste on /login>
# (dev auth is hard-refused by the backend when APP_ENV=production).
NEXT_PUBLIC_OPERATOR_API_URL=http://127.0.0.1:8100
